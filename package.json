{
  "name": "merlin-or",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Merlin OR product seed: read-only daily coordination surface backed by LISA context.",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:or": "dotenv -e .env -- tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json && npm --prefix web ci && npm --prefix web run build",
    "build:web": "npm --prefix web run build",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:contracts": "node --test scripts/*.contract.test.mjs",
    "lint": "npm run check",
    "screenshots:move": "tsx scripts/screenshots-manifest-move-and-seed.ts --mode=execute",
    "screenshots:diagnose": "tsx scripts/screenshots-manifest-move-and-seed.ts --mode=diagnose",
    "screenshots:copy": "tsx scripts/screenshots-manifest-move-and-seed.ts --mode=copy",
    "test:browser": "playwright test",
    "drive:auth:token": "tsx scripts/generate-google-refresh-token.ts"
  },
  "dependencies": {
    "@types/node": "^24.10.1",
    "better-sqlite3": "^12.4.2",
    "googleapis": "^148.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@playwright/test": "^1.55.1",
    "dotenv-cli": "^11.0.0"
  }
}
