{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Merlin Daily",
  "type": "object",
  "required": [
    "date",
    "user_id",
    "sections",
    "generated_at"
  ],
  "properties": {
    "date": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "sections": {
      "type": "object",
      "required": [
        "changed",
        "needs_attention",
        "waiting",
        "stale",
        "suggested_next_steps"
      ],
      "properties": {
        "changed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "needs_attention": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "waiting": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "stale": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "suggested_next_steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string"
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id",
        "title",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "confidence": {
          "type": "number"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
