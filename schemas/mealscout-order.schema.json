{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/infotradescout/merlin-os-action-layer/schemas/mealscout-order.schema.json",
  "title": "MealScout Online Order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "vendor_id",
    "customer_reference",
    "order_total_amount",
    "processing_paid_by",
    "mealscout_fee_amount",
    "mealscout_fee_paid_by",
    "currency",
    "status"
  ],
  "properties": {
    "order_id": { "type": "string", "minLength": 1 },
    "vendor_id": { "type": "string", "minLength": 1 },
    "customer_reference": { "type": "string", "minLength": 1 },
    "order_total_amount": { "type": "integer", "minimum": 0, "description": "Order amount in cents before processing and platform fee." },
    "processing_paid_by": { "type": "string", "const": "customer" },
    "mealscout_fee_amount": { "type": "integer", "const": 100 },
    "mealscout_fee_paid_by": { "type": "string", "const": "customer" },
    "currency": { "type": "string", "const": "usd" },
    "status": { "type": "string", "enum": ["draft", "pending_payment", "paid", "fulfilled", "cancelled", "refunded"] },
    "stripe_payment_intent_id": { "type": "string" },
    "notes": { "type": "string" }
  }
}
